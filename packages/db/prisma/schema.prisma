// Countertop Reserve — data model (V-003, after the schema-review pause).
//
// RULES THIS FILE WILL OBEY (CLAUDE.md, "Database rules"):
//
//  * The allocation constraint is an EXCLUSION constraint on TableHold:
//    (tableId =, [startAt, endAt) &&). Decided at the V-003 review over a
//    literal UNIQUE: turns vary by party size, so two windows that overlap
//    are not equal, and a unique index cannot see the collision. Concurrent
//    bookings contend on the constraint, not on check-then-write.
//  * The idempotency key has a unique constraint. The disabled submit button
//    is UX; the constraint is the mechanism.
//  * Reservation and message tables carry COPIED data as columns — the
//    snapshot rule (CLAUDE.md) extends to rendered message text, not just
//    guest/table facts. FKs back to the floor plan or templates, if kept for
//    analytics, are onDelete: Restrict and never read for display.
//  * Instants are @db.Timestamptz(3). The business day / service period is a
//    restaurant-timezone string, never a Postgres `date` coerced through the
//    process timezone.
//
// WHAT PRISMA CANNOT EXPRESS, AND SO LIVES IN A HAND-WRITTEN MIGRATION:
//   1. The append-only trigger on the reservation event log (undo writes a
//      logged revert event; it never deletes).
//   2. The TableHold exclusion constraint and the btree_gist extension it
//      needs (a gist index over a plain text column needs btree_gist).
//   3. CHECK constraints (positive party size and turn, endAt > startAt).
//
// NEVER `prisma db push`. Never edit an applied migration.
// (`prisma migrate dev --create-only`, then edit.)

generator client {
  provider = "prisma-client-js"
  // NO custom `output`. A client generated outside node_modules is imported
  // by relative path, which Next's `serverExternalPackages` cannot name —
  // Turbopack then bundles it, and a bundled Prisma client cannot find its
  // own query engine at deploy time. Countertop paid for this at C-045;
  // inherited as a lesson here, not rediscovered.
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Floor plan (P0-1). Current inventory; reservations never read it for
// display — they carry their own snapshot.

model DiningTable {
  id       String @id // "T4" — the host's name for it
  seats    Int
  minParty Int
  section  String

  combinations CombinationMember[]
  holds        TableHold[]
}

/// Declared, never inferred: [T4, T5] → 4 seats.
model Combination {
  id       String @id
  seats    Int
  minParty Int

  members CombinationMember[]
}

model CombinationMember {
  combinationId String
  tableId       String

  combination Combination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  table       DiningTable @relation(fields: [tableId], references: [id], onDelete: Restrict)

  @@id([combinationId, tableId])
}

// ─── Reservations (P0-3). Every column a reader displays is a COPY taken at
// booking; nothing here is recomputed from today's floor plan or turn bands.

model Reservation {
  id             String   @id @default(uuid()) @db.Uuid
  /// Client-generated. A double-submit finds this row and returns it.
  idempotencyKey String   @unique
  /// Restaurant-timezone YYYY-MM-DD — never a Postgres `date`.
  businessDay    String
  startAt        DateTime @db.Timestamptz(3)
  partySize      Int
  /// Snapshot of the turn at booking.
  turnMinutes    Int
  /// Snapshot of the tables seated at. Display and HeldReservation read
  /// this, never TableHold (holds are deleted on release).
  tableIds       String[]
  guestName      String
  /// E.164.
  guestPhone     String
  /// Guest note, ≤140 chars (CHECK).
  note           String?
  /// Tag KINDS only — allergy | occasion | accessibility (CHECK). The detail
  /// ("shellfish") goes in the note; the host view styles by kind (P0-9).
  tags           String[] @default([])
  /// ponytail: plain text until V-004's lifecycle module owns the list; a
  /// DB enum here would be a second source of truth.
  status          String
  createdAt       DateTime @db.Timestamptz(3)
  statusChangedAt DateTime @db.Timestamptz(3)
  /// 128 random bits, base64url. The manage link's only credential (P0-5).
  manageToken     String   @unique

  holds    TableHold[]
  events   ReservationEvent[]
  messages OutboundMessage[]

  @@index([businessDay, startAt])
  @@index([guestPhone])
}

/// Live inventory: one row per (reservation, table). A combination writes one
/// row per member table with the same window, so a combination booking
/// cannot double-seat one of its own halves. Releasing a table DELETEs its
/// rows in the same transaction as the status event — the table is real
/// inventory the instant that commits.
model TableHold {
  reservationId String   @db.Uuid
  tableId       String
  startAt       DateTime @db.Timestamptz(3)
  endAt         DateTime @db.Timestamptz(3)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  table       DiningTable @relation(fields: [tableId], references: [id], onDelete: Restrict)

  @@id([reservationId, tableId])
}

/// Append-only (trigger). Every transition, including those driven by an
/// inbound SMS reply; an undo is a logged revert event, never a delete.
model ReservationEvent {
  id            BigInt   @id @default(autoincrement())
  reservationId String   @db.Uuid
  at            DateTime @db.Timestamptz(3)
  fromStatus    String?
  toStatus      String
  /// guest_web | sms | host | system
  source        String
  note          String?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId, at])
}

/// The outbound queue (P0-5). `body` is the RENDERED text, snapshotted at
/// queue time and sent verbatim — never re-rendered from a template.
/// One row per (reservation, kind): a retry cannot text a guest twice.
model OutboundMessage {
  id                String   @id @default(uuid()) @db.Uuid
  reservationId     String   @db.Uuid
  /// MESSAGE_KINDS (CHECK)
  kind              String
  /// Snapshot of the guest's number at queue time.
  toPhone           String
  body              String
  /// DELIVERY_STATUSES (CHECK); sent/delivered require a provider id,
  /// failed requires a reason.
  status            String
  providerMessageId String?  @unique
  failureReason     String?
  createdAt         DateTime @db.Timestamptz(3)
  statusChangedAt   DateTime @db.Timestamptz(3)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([reservationId, kind])
  @@index([status, createdAt])
}
