# Copy to .env.local for real dev values. Names only here — see
# CLAUDE.md "Source control" (never commit real values).

# Local Postgres. .env.test overrides only DATABASE_URL/DIRECT_URL, first-wins
# via `dotenv -e .env.test -e .env.local`. The demo runs on THIS database:
# `npm run dev:demo` loads .env.local alone (docs/DEMO.md).
DATABASE_URL=
DIRECT_URL=

# This repo owns 3500 (storage 3000, rental 3100, event toolkit 3200,
# bookable 3300, Countertop 3400). The value is also the config default in
# apps/web/package.json and playwright.config.ts — a forgotten env var cannot
# hijack a neighbour's port.
PORT=3500

# Shared secret for the inbound-SMS webhook signature (HMAC-SHA256 of the raw
# body, hex, in the x-signature header). Unset = the webhook refuses every
# request. Any value works locally; both .env.test (e2e) and .env.local
# (the live-SMS section of the demo) need one.
SMS_WEBHOOK_SECRET=

# Bearer token for GET /api/cron/sweep (the deadline sweep: auto-release,
# reminders, dispatch). Unset = the route refuses every request. Vercel Cron
# sends it as `Authorization: Bearer $CRON_SECRET`. Both .env.test (e2e) and
# .env.local (running a sweep during the demo) need one.
CRON_SECRET=

# The host floor view's shared passcode (/host). Unset = the screens stay
# locked and the sign-in page says so. .env.test needs one for e2e.
STAFF_PASSCODE=
