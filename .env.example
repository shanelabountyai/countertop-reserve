# Copy to .env.local for real dev values. Names only here — see
# CLAUDE.md "Source control" (never commit real values).

# Local Postgres. .env.test overrides only DATABASE_URL/DIRECT_URL, first-wins
# via `dotenv -e .env.test -e .env.local`.
DATABASE_URL=
DIRECT_URL=

# This repo owns 3500 (storage 3000, rental 3100, event toolkit 3200,
# bookable 3300, Countertop 3400). The value is also the config default in
# apps/web/package.json and playwright.config.ts — a forgotten env var cannot
# hijack a neighbour's port.
PORT=3500
